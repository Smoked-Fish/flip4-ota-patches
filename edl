#!/usr/bin/env bash
# Usage: ./edl <edl.py args>
set -e
DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
VENV="$DIR/.venv"
REQS="$DIR/edlclient/requirements.txt"

if [ ! -x "$VENV/bin/python" ] || [ "$REQS" -nt "$VENV/.installed" ]; then
    if ! command -v python3 >/dev/null; then
        echo "python3 not found. Install it first" >&2
        exit 1
    fi
    echo "Setting up Python environment in $VENV" >&2
    if ! python3 -m venv "$VENV"; then
        rm -rf "$VENV"
        echo "Could not create venv. Is python3-venv installed?" >&2
        exit 1
    fi
    "$VENV/bin/pip" install -q --upgrade pip
    "$VENV/bin/pip" install -q -r "$REQS"
    touch "$VENV/.installed"
fi

PYTHONPATH="$DIR" exec "$VENV/bin/python" "$DIR/edlclient/edl.py" "$@"